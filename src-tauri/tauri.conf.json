{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Por Auto",
  "version": "0.3.6",
  "identifier": "com.por.wechatreader",
  "build": {
    "beforeDevCommand": "pnpm prepare:u2 && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm prepare:u2 && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Por Auto",
        "width": 1120,
        "height": 800,
        "minWidth": 820,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "capabilities": [
        {
          "identifier": "main",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/platform-tools.zip",
      "resources/adb-manifest.json",
      "resources/u2.jar",
      "resources/u2-hint.dex",
      "resources/u2-NOTICE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3QTQxMzUxNTQxMUY0RTIKUldUaTlCRlVVUk9rZHhCbyszYU1oYmZObG9uM3RzbXBYSjlRSmJVZDhxUDhWMjJ6bWgwRDdUclYK",
      "endpoints": [
        "https://github.com/guygubaby/por-auto/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
