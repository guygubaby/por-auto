{
  "schemaVersion": 1,
  "minEngine": 3,
  "id": "wechat-send-hello",
  "name": "向文件传输助手发送 1",
  "version": "2.0.0",
  "description": "打开微信，返回会话列表，精确查找文件传输助手并发送一次「1」。保留已有草稿；发送结果不明时停止，不自动重发。",
  "package": "com.tencent.mm",
  "steps": [
    {
      "name": "唤醒手机",
      "action": {
        "type": "wake"
      },
      "id": "step-1"
    },
    {
      "name": "打开微信",
      "action": {
        "type": "launch",
        "activity": "com.tencent.mm.ui.LauncherUI"
      },
      "id": "step-2"
    },
    {
      "name": "等待页面显示",
      "action": {
        "type": "wait",
        "ms": 1600
      },
      "id": "step-3"
    },
    {
      "name": "进入文件传输助手",
      "action": {
        "type": "wechat_open_chat",
        "target": "文件传输助手",
        "output": "chat_title"
      },
      "id": "step-4"
    },
    {
      "name": "输入1并发送一次",
      "action": {
        "type": "wechat_send_text",
        "text": "1"
      },
      "id": "step-5"
    }
  ]
}
