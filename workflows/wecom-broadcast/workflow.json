{
  "schemaVersion": 1,
  "minEngine": 5,
  "id": "wecom-broadcast",
  "name": "企业微信批量发送消息",
  "version": "1.1.1",
  "description": "选择全部单聊、全部群聊或两者，按原生列表逐个处理并发送；支持手动或 HTTP 消息、预演、逐会话记录与定时任务。",
  "package": "com.tencent.wework",
  "steps": [
    {
      "id": "wake",
      "name": "唤醒手机",
      "action": {
        "type": "wake"
      }
    },
    {
      "id": "launch",
      "name": "打开企业微信",
      "action": {
        "type": "launch",
        "activity": ".launch.LaunchSplashActivity"
      }
    },
    {
      "id": "wait",
      "name": "等待页面就绪",
      "action": {
        "type": "wait",
        "ms": 1200
      }
    },
    {
      "id": "broadcast",
      "name": "处理配置的接收对象",
      "action": {
        "type": "chat_broadcast"
      }
    }
  ],
  "inputSchema": {
    "$ref": "por-auto://schemas/chat-send-input/v1"
  }
}
