{
  "schemaVersion": 1,
  "minEngine": 3,
  "id": "wechat-broadcast",
  "name": "微信批量发送消息",
  "version": "1.0.0",
  "description": "手动输入消息或通过 HTTP 获取；读取群聊或会话列表，勾选接收对象或选择全部。逐个核对会话并保存发送结果。支持定时任务。",
  "package": "com.tencent.mm",
  "inputSchema": {
    "$ref": "por-auto://schemas/wechat-send-input/v1"
  },
  "steps": [
    {
      "id": "wake",
      "name": "唤醒手机",
      "action": {
        "type": "wake"
      }
    },
    {
      "id": "launch",
      "name": "打开微信",
      "action": {
        "type": "launch",
        "activity": "com.tencent.mm.ui.LauncherUI"
      }
    },
    {
      "id": "wait",
      "name": "等待页面显示",
      "action": {
        "type": "wait",
        "ms": 1600
      }
    },
    {
      "id": "home",
      "name": "回到微信会话列表",
      "action": {
        "type": "wechat_home"
      }
    },
    {
      "id": "send",
      "name": "获取消息、核对接收会话并发送",
      "action": {
        "type": "wechat_broadcast"
      }
    }
  ]
}
