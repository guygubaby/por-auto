{
  "name": "por-auto",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm prepare:assets && go run github.com/egoist/mygo/cmd/mygo dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "pnpm prepare:assets && go run github.com/egoist/mygo/cmd/mygo build",
    "build:web": "tsc --noEmit && vite build",
    "build:mac": "pnpm prepare:adb macos && pnpm build",
    "build:windows": "pnpm prepare:adb windows && pnpm prepare:assets && go run github.com/egoist/mygo/cmd/mygo build -platform windows/amd64",
    "generate": "go run github.com/egoist/mygo/cmd/mygo generate",
    "test": "vitest run",
    "test:go": "go test ./internal/...",
    "test:devices": "vitest run src/lib/batch.test.ts",
    "test:schedules": "vitest run src/lib/schedule.test.ts",
    "test:http-editor": "vitest run src/lib/http.test.ts",
    "test:updates": "node --test scripts/test-release.mjs",
    "release:check": "node scripts/release-manifest.mjs --check",
    "prepare:adb": "node scripts/prepare-adb.mjs",
    "prepare:u2": "node scripts/prepare-u2.mjs",
    "prepare:input": "node scripts/input-artifact.mjs",
    "prepare:assets": "pnpm prepare:input && pnpm prepare:u2 && pnpm mobile:check && node scripts/prepare-assets.mjs",
    "registry:index": "node scripts/registry-index.mjs",
    "registry:check": "node scripts/registry-index.mjs --check",
    "mobile:bundle": "node scripts/mobile-scripts.mjs bundle",
    "mobile:check": "node scripts/mobile-scripts.mjs check",
    "test:mobile": "node --test scripts/test-mobile-updater.mjs scripts/test-mobile-workflows.mjs scripts/test-mobile-schedules.mjs scripts/test-mobile-runtime.mjs scripts/test-input-artifact.mjs",
    "test:adb-paths": "node scripts/test-adb-paths.mjs"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "ky": "^2.2.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "mygo-runtime": "0.6.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ufo": "^1.6.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
