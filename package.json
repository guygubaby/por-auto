{
  "name": "wechat-connection-demo",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "pnpm mobile:check && vue-tsc --noEmit && vite build",
    "test:devices": "node --test scripts/test-device-batch.mjs",
    "test:schedules": "node --test scripts/test-schedules.mjs",
    "test:updates": "node --test scripts/test-release.mjs scripts/test-app-updater.mjs",
    "release:check": "node scripts/release-manifest.mjs --check",
    "tauri": "tauri",
    "prepare:adb": "node scripts/prepare-adb.mjs",
    "registry:index": "node scripts/registry-index.mjs",
    "registry:check": "node scripts/registry-index.mjs --check",
    "build:windows": "bash scripts/build-windows.sh",
    "build:mac": "pnpm prepare:adb macos && pnpm prepare:u2 && tauri build --bundles app,dmg",
    "prepare:u2": "node scripts/prepare-u2.mjs",
    "test:adb-paths": "node scripts/test-adb-paths.mjs",
    "mobile:bundle": "node scripts/mobile-scripts.mjs bundle",
    "mobile:check": "node scripts/mobile-scripts.mjs check",
    "test:mobile": "node --test scripts/test-mobile-updater.mjs scripts/test-mobile-workflows.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.57.0",
    "@tauri-apps/api": "^2.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.0.0"
  }
}
