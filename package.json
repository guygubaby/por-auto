{
  "name": "wechat-connection-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "prepare:adb": "node scripts/prepare-adb.mjs",
    "registry:index": "node scripts/registry-index.mjs",
    "registry:check": "node scripts/registry-index.mjs --check",
    "build:windows": "bash scripts/build-windows.sh",
    "build:mac": "pnpm prepare:adb macos && tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@lucide/vue": "^1.57.0",
    "@tauri-apps/api": "^2.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.0.0"
  }
}
